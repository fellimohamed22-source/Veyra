# Veyra production environment template
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://postgres.example.internal:5432/veyra
DB_USER=veyra
DB_PASSWORD=change-me

REDIS_HOST=redis.example.internal
REDIS_PORT=6379

JWT_SECRET=replace-with-at-least-32-random-bytes
PIN_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
VEYRA_ALLOWED_ORIGINS=https://admin.example.com,https://partner.example.com
VEYRA_DOCUMENT_ROOT=/app/runtime/documents

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

VEYRA_BOOTSTRAP_ADMIN_EMAIL=
VEYRA_BOOTSTRAP_ADMIN_PASSWORD=
